{
  "name": "lucid-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env HOSTNAME=0.0.0.0 next dev --webpack",
    "dev:mail": "cross-env EMAIL_TRANSPORT=smtp EMAIL_SMTP_HOST=127.0.0.1 EMAIL_SMTP_PORT=54325 NEXT_PUBLIC_APP_URL=http://localhost:3000 HOSTNAME=0.0.0.0 next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run typecheck && npm run lint && npm run test:run && npm run test:e2e",
    "test:e2e:ci": "playwright test --config=playwright.ci.config.ts",
    "e2e:server": "npm run build && npm run start",
    "test:all:ci": "npm run test:run && npm run test:e2e:ci",
    "playwright:install": "playwright install --with-deps",
    "cleanup:audit-logs": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} scripts/cleanup-corrupted-audit-logs.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
