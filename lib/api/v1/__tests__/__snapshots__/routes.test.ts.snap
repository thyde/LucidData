  "info": {
    "contact": {
      "email": "support@luciddatabank.com",
    },
    "description": "The API the LucidData phone app and browser extensions use. Vault entries are encrypted on the device before they are sent, so the server stores and returns ciphertext it cannot read. Every request acts as the signed-in person, and row level security limits it to their own data. Request bodies are generated from the same schemas the server validates against.",
    "title": "LucidData client API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account": {
      "delete": {
        "description": "Needs the phrase DELETE MY ACCOUNT and a step-up grant for delete_account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountDelete",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {},
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The signed deletion receipt.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input, or a refusal written for the person.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Missing or invalid token, a revoked session, or a second factor still to complete.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Too many requests. Try again shortly.",
          },
        },
        "summary": "Delete the account",
      },
    },
    "/api/v1/audit": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {},
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "The audit log, and whether its hash chain verifies.",
          },
          "400": {
